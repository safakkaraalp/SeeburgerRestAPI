<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/instance_row_background"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/instanceEnvBadge"
        android:layout_width="58dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="DEV"
        android:textColor="#166534"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/status_success_background" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/instanceTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ProcessInstance #1"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/instanceIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ID: ..."
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/instanceProcessText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Process: ..."
            android:textColor="#6B7280"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/instanceStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="State: 3"
        android:textColor="#374151"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>